# 1. Prime Number Function
def is_prime(number):
    if number < 2:
        return False

    for i in range(2, int(number ** 0.5) + 1):
        if number % i == 0:
            return False

    return True


# 2. *args Function
def find_largest(*args):
    if not args:
        return None

    return max(args)


# 3. **kwargs Function
def student_info(**kwargs):
    print("\nStudent Information:")

    for key, value in kwargs.items():
        print(f"{key}: {value}")


# 4. Statistics Function
def calculate_statistics(numbers):
    if not numbers:
        return None

    total = sum(numbers)
    maximum = max(numbers)
    minimum = min(numbers)
    average = total / len(numbers)

    return {
        "maximum": maximum,
        "minimum": minimum,
        "average": average,
        "sum": total
    }


# ---------------- TESTING ---------------- #

# Prime number
number = 29

print("Prime Number Check")
print("------------------")

if is_prime(number):
    print(number, "is prime")
else:
    print(number, "is not prime")


# *args
print("\nLargest Number")
print("--------------")

print(find_largest(10, 25, 7, 45, 18))


# **kwargs
student_info(
    name="Amit",
    age=21,
    course="Python",
    marks=85
)


# Statistics
numbers = [10, 20, 30, 40, 50]

stats = calculate_statistics(numbers)

