import pandas as pd
import matplotlib.pyplot as plt

# ---------------- DATASET ---------------- #

data = {
    "DATE": [
        "2024-01-01",
        "2024-01-02",
        "2024-01-03",
        "2024-01-04",
        "2024-01-05",
        "2024-01-06",
        "2024-01-07"
    ],

    "STOCK_PRICE": [
        100,
        105,
        102,
        110,
        115,
        108,
        120
    ]
}

# Create DataFrame
df = pd.DataFrame(data)

# Convert DATE column to datetime
df["DATE"] = pd.to_datetime(df["DATE"])

print("Stock Dataset:\n")
print(df)

# ---------------- MOVING AVERAGE ---------------- #

# 3-day moving average
df["MOVING_AVG"] = df["STOCK_PRICE"].rolling(
    window=3
).mean()

# ---------------- PEAKS & DROPS ---------------- #

highest_price = df["STOCK_PRICE"].max()
lowest_price = df["STOCK_PRICE"].min()

highest_day = df.loc[
    df["STOCK_PRICE"].idxmax(),
    "DATE"
]

lowest_day = df.loc[
    df["STOCK_PRICE"].idxmin(),
    "DATE"
]

# ---------------- VOLATILITY ---------------- #

volatility = df["STOCK_PRICE"].std()

# ---------------- VISUALIZATION ---------------- #

plt.figure(figsize=(10, 5))

# Stock price trend
plt.plot(
    df["DATE"],
    df["STOCK_PRICE"],
    marker='o',
    label="Stock Price"
)

# Moving average line
plt.plot(
    df["DATE"],
    df["MOVING_AVG"],
    linestyle='--',
    label="3-Day Moving Average"
)

# Labels and title
plt.title("Stock Price Trend Analysis")
plt.xlabel("Date")
plt.ylabel("Price")

# Legend
plt.legend()

# Grid
plt.grid(True)

# Show chart
plt.show()

# ---------------- OUTPUT ---------------- #

print("\n------ ANALYSIS ------")

print("\nHighest Price:", highest_price)
print("Highest Price Day:", highest_day.date())

print("\nLowest Price:", lowest_price)
print("Lowest Price Day:", lowest_day.date())

print("\nVolatility (Standard Deviation):")
print(round(volatility, 2))

print("\nDataset with Moving Average:\n")
print(df)
